{
  "name": "tuxchat",
  "version": "0.1.0",
  "description": "Unofficial WhatsApp Web desktop client for Linux (Electron), with full call/screen-share support and multiple isolated profiles.",
  "main": "app/index.js",
  "homepage": "https://github.com/histerick/tuxchat",
  "author": {
    "name": "TuxChat contributors",
    "email": "dev@ericksalamanca.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron . --ozone-platform=x11",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "app.tuxchat.desktop",
    "productName": "TuxChat",
    "directories": {
      "output": "dist"
    },
    "files": ["app/**/*", "package.json"],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Network",
      "icon": "build/icon.png"
    }
  }
}
