{
  "name": "tuxchat",
  "version": "0.2.1",
  "description": "Unofficial WhatsApp Web desktop client for Linux (Electron), with full call/screen-share support, multiple isolated profiles, and whatsapp:// deep-link support.",
  "main": "app/index.js",
  "desktopName": "tuxchat.desktop",
  "homepage": "https://github.com/histerick/tuxchat",
  "author": {
    "name": "TuxChat contributors",
    "email": "dev@ericksalamanca.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "app.tuxchat.desktop",
    "productName": "TuxChat",
    "executableName": "tuxchat",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "build/icon.png",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "histerick",
      "repo": "tuxchat",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
